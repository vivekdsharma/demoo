generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  PENDING
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String?
  avatar           String?
  googleId         String?  @unique
  slackWebhookUrl  String?
  slackAccessToken String?
  slackChannel     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  emails           Email[]

  @@map("users")
}

model Sender {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  hourlyLimit  Int      @default(50)
  delaySeconds Int      @default(2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  emails       Email[]

  @@map("senders")
}

model Email {
  id                 String      @id @default(uuid())
  recipient          String
  subject            String
  body               String
  status             EmailStatus @default(SCHEDULED)
  scheduledAt        DateTime
  sentAt             DateTime?
  failedReason       String?
  etherealMessageId  String?
  etherealPreviewUrl String?
  jobId              String?     @unique
  retryCount         Int         @default(0)
  batchId            String?

  senderId           String
  sender             Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([senderId])
  @@index([recipient])
  @@map("emails")
}

model RateLimitEvent {
  id         String   @id @default(uuid())
  senderId   String
  hourWindow String
  emailCount Int
  hourlyLimit Int
  slackNotified Boolean @default(false)
  createdAt  DateTime @default(now())

  @@unique([senderId, hourWindow])
  @@map("rate_limit_events")
}
