{
  "name": "reachinbox-scheduler-backend",
  "version": "1.0.0",
  "description": "Production-grade distributed email scheduler with BullMQ, Redis, PostgreSQL, Elasticsearch, and Slack integration",
  "main": "dist/server.js",
  "scripts": {
    "predev": "node scripts/ensure-services.cjs",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/workers/email.worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "email-scheduler",
    "bullmq",
    "redis",
    "reachinbox",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^9.11.0",
    "@bull-board/express": "^9.11.0",
    "@elastic/elasticsearch": "^9.5.1",
    "@prisma/client": "6.4.1",
    "@slack/web-api": "^8.3.0",
    "bullmq": "^6.5.4",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^6.4.17",
    "prisma": "6.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
